`timescale 1ps/1ps
module tb;
  integer hs,hd,phase,case_id;
  reg sc=0,dc=0,cpucause=0,uicause=0,send=0,wantw=0,armed=0,observe=0;
  wire sr,ui_wr,s_clock; wire dr=uicause; wire ip_reset_n=~ui_wr;
  wire enready,devalid,take,wready,bvalid,rv,wv,rsn,ssn;
  wire [1:0] bresp; wire [3:0] bid,ri,wi; wire [60:0] dataout;
  wire mc_en,mc_wren; wire [2:0] mc_cmd; integer mc_reqs=0,mc_data=0;
  integer enq=0,aw=0,w=0,b=0,tail=0,valid_edges=0,obs=0;
  wire [31:0] next_addr=32'h4000+(enq<<3);
  wire [60:0] datain={4'd2,next_addr,8'd0,3'd3,2'd1,1'b0,4'd3,3'd0,4'd0};
  initial begin
    if($test$plusargs("CASE0")) begin hs=2857;hd=2500;phase=113;case_id=0;end
    else if($test$plusargs("CASE1")) begin hs=2857;hd=2500;phase=1569;case_id=1;end
    else if($test$plusargs("CASE2")) begin hs=2500;hd=2857;phase=479;case_id=2;end
    else if($test$plusargs("CASE3")) begin hs=2101;hd=4591;phase=151;case_id=3;end
    else $fatal(1,"case arg");
    fork forever #(hs) sc=~sc; begin #(phase); forever #(hd) dc=~dc; end join
  end
  ResetWrangler wr(.auto_in_1_clock(dc),.auto_in_1_reset(uicause),.auto_in_0_clock(sc),.auto_in_0_reset(cpucause),
                  .auto_out_0_clock(s_clock),.auto_out_0_reset(sr),.auto_out_1_reset(ui_wr));
  // AW_DUT
  // These parameters follow this generated controller's unoverridden parent defaults.
  ddr4_v2_2_24_axi #(.C_ECC("OFF"),.C_S_AXI_ID_WIDTH(4),.C_S_AXI_ADDR_WIDTH(31),.C_S_AXI_DATA_WIDTH(64),
    .C_MC_ADDR_WIDTH(28),.C_MC_DATA_WIDTH(512),.C_MC_BURST_MODE("8"),.C_MC_nCK_PER_CLK(4),.C_S_AXI_SUPPORTS_NARROW_BURST(0),
    .C_RD_WR_ARB_ALGORITHM("RD_PRI_REG"),.C_S_AXI_REG_EN0(20'h00000),.C_S_AXI_REG_EN1(20'h00000)) ip(
    .aclk(dc),.aresetn(ip_reset_n),.s_axi_awid(dataout[60:57]),.s_axi_awaddr(dataout[55:25]),.s_axi_awlen(dataout[24:17]),
    .s_axi_awsize(dataout[16:14]),.s_axi_awburst(dataout[13:12]),.s_axi_awlock(dataout[11]),.s_axi_awcache(4'h3),
    .s_axi_awprot(dataout[6:4]),.s_axi_awqos(dataout[3:0]),.s_axi_awvalid(devalid),.s_axi_awready(take),
    .s_axi_wdata(64'hcc7799565a3c481e),.s_axi_wstrb(8'hff),.s_axi_wvalid(wantw),.s_axi_wready(wready),.s_axi_wlast(1'b1),
    .s_axi_bready(1'b1),.s_axi_bvalid(bvalid),.s_axi_bid(bid),.s_axi_bresp(bresp),.s_axi_arid(4'h0),.s_axi_araddr(31'd0),
    .s_axi_arlen(8'd0),.s_axi_arsize(3'd3),.s_axi_arburst(2'd1),.s_axi_arlock(1'd0),.s_axi_arcache(4'h3),.s_axi_arprot(3'd0),
    .s_axi_awuser(1'b0),.s_axi_aruser(1'b0),.s_axi_arqos(4'd0),.s_axi_arvalid(1'b0),.s_axi_rready(1'b1),.mc_app_rdy(1'b1),.mc_init_complete(1'b1),.mc_app_wdf_rdy(1'b1),
    .mc_app_en(mc_en),.mc_app_cmd(mc_cmd),.mc_app_wdf_wren(mc_wren),.mc_app_rd_valid(1'b0),.mc_app_rd_data(512'd0),.mc_app_rd_end(1'b0),.mc_app_ecc_multiple_err(8'd0));
  always @(posedge sc) if(armed && send && enready) enq<=enq+1;
  always @(posedge dc) if(armed) begin
    if(observe) begin
      if((^{ip_reset_n,take,devalid})===1'bx || ip_reset_n!==0) $fatal(1,"unknown/reset sampling");
      $display("MIG_EDGE %0d %b %b %b",obs,ip_reset_n,devalid,take); obs<=obs+1;
      if(devalid) valid_edges<=valid_edges+1;
      if(take && devalid) tail<=tail+1;
    end
    if((^{mc_en,mc_wren,wready,bvalid,devalid,take})===1'bx) $fatal(1,"unknown controller or AXI qualifier");
    if(mc_en) mc_reqs<=mc_reqs+1; if(mc_wren) mc_data<=mc_data+1;
    if(take && devalid) aw<=aw+1;
    if(wready && wantw) w<=w+1;
    if(bvalid) begin if({bid,bresp}!==6'b001000) $fatal(1,"bad B"); b<=b+1; end
  end
  task automatic one_write;
    integer e0,a0,b0,w0;
    begin e0=enq; a0=aw; b0=b; w0=w;
      fork
        begin @(negedge sc); send=1; wait(enq==e0+1); @(negedge sc); send=0; end
        begin @(negedge dc); wantw=1; wait(w==w0+1); @(negedge dc); wantw=0; end
      join
      wait(b==b0+1); repeat(12) @(negedge dc);
      if(aw!=a0+1 || w!=w0+1 || b!=b0+1 || devalid!==0) $fatal(1,"clean transfer incomplete");
    end
  endtask
  integer mark,pre_mc,pre_data;
  initial begin
    #37; uicause=1; cpucause=1; repeat(8) @(negedge sc); #211; cpucause=0; repeat(4) @(negedge dc); #143; uicause=0;
    wait(sr===0 && ui_wr===0); repeat(24) @(negedge sc); repeat(3) @(negedge dc); armed=1; one_write;
    // Continuously offer addresses with WVALID=0. At the first pending AW
    // assert CPU cause away from both sampling edges. AWREADY is generated by ip.
    @(negedge sc); send=1; wait(devalid===1); @(negedge dc); #211;
    mark=aw; pre_mc=mc_reqs; pre_data=mc_data; cpucause=1; send=0; #13;
    if({sr,dr,ip_reset_n,devalid}!==4'b1001) $fatal(1,"not testing intended edge"); observe=1;
    #787; cpucause=0; repeat(10) @(negedge dc); observe=0;
    if(obs!=10 || valid_edges<1 || valid_edges>3 || aw!=mark+tail || tail>valid_edges) $fatal(1,"tail accounting");
    wait(sr===0 && ip_reset_n===1); repeat(30) @(negedge sc); repeat(8) @(negedge dc);
    if({enready,devalid}!==2'b10 || w!=1 || b!=1 || ri!==0 || wi!==0) $fatal(1,"not recovered");
    if(pre_mc<1 || pre_data<1 || pre_mc!=mc_reqs || pre_data!=mc_data) $fatal(1,"unexpected memory-controller request across reset");
    one_write;
    $display("MIG_AW_RESULT case=%0d hs=%0d hd=%0d phase=%0d pending_edges=%0d pin_overlaps=%0d clean_b_responses=%0d intervening_mc_requests=0 intervening_mc_data=0",case_id,hs,hd,phase,valid_edges,tail,b); $finish;
  end
  initial #1100000000 $fatal(1,"watchdog: aw=%0d w=%0d b=%0d",aw,w,b);
endmodule
