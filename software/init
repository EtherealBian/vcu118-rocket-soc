#!/bin/sh
export PATH=/bin:/sbin
mount -t devtmpfs devtmpfs /dev || exit 1
mount -t proc proc /proc || exit 1
mount -t sysfs sysfs /sys || exit 1
echo VCU118_INITRAMFS_READY
uname -a
/bin/soc-check 0 || { echo SOC_SELFTEST_FAILED; exec /bin/sh -i; }
# Lab-only local console. No networking, remote login or preconfigured password.
while :; do /bin/setsid /bin/cttyhack /bin/sh -i; done
