CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_NONPORTABLE=n
CONFIG_SOC_VIRT=y
CONFIG_SOC_SIFIVE=y
CONFIG_FPU=y
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_ISA_FALLBACK=y
CONFIG_SMP=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_SIFIVE=y
CONFIG_SERIAL_SIFIVE_CONSOLE=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_SIFIVE=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SPI=y
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_UNIX98_PTYS=y
CONFIG_SIGNALFD=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_EMBEDDED=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_CMDLINE="console=ttyS0,115200 console=ttySIF0,115200"
CONFIG_CMDLINE_FALLBACK=y

# A separately provisioned data partition; never mount the raw firmware partition.
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# QEMU-only verification transport; harmless if absent in the real device tree.
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
